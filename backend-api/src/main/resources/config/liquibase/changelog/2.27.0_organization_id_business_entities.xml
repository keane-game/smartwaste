    <!--
      ADR-0020 §2-3 — Discriminant organizationId sur les agrégats métier cloisonnés.

      Chaque table reçoit sa propre colonne (pas de dérivation par jointure : un filtre Hibernate
      de session ne peut pas résoudre efficacement un ancêtre à chaque ligne). Backfill vers
      « Ville de Pikine » (01983c4f-0001-7000-8000-000000000001, semée en 2.2.0-3) : c'est la seule
      collectivité active, et ADR-0020 en fait explicitement la référence de démarrage — aucune
      donnée existante ne doit se retrouver orpheline de collectivité.

      Colonne posée `nullable` puis verrouillée `NOT NULL` dans le même changeset (pas une expansion
      en deux temps sur plusieurs releases) : cohérent avec le reste de ce projet, où la base de
      développement est assumée jetable (cf. 2.0.0/2.1.0, destructeurs).

      ⚠️ Ce changelog ajoute la COLONNE et le backfill. Il n'active AUCUN filtre applicatif : le
      filtre Hibernate `organizationFilter` défini sur chaque entité reste inerte tant qu'aucune
      session ne l'active explicitement (ADR-0020 §4, non câblé à cette étape).
    -->

    <property name="pikineOrgId" value="01983c4f-0001-7000-8000-000000000001"/>

    <changeSet author="claude" id="2.27.0-1-commune">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="commune" columnName="organizationid"/></not>
        </preConditions>
        <comment>Commune : ancre du référentiel territorial d'une collectivité.</comment>
        <addColumn tableName="commune"><column name="organizationid" type="uuid"/></addColumn>
        <sql>UPDATE commune SET organizationid = '${pikineOrgId}' WHERE organizationid IS NULL</sql>
        <addNotNullConstraint tableName="commune" columnName="organizationid" columnDataType="uuid"/>
        <createIndex indexName="idx_commune_organizationid" tableName="commune">
            <column name="organizationid"/>
        </createIndex>
    </changeSet>


<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>sonaged.collecte</groupId>
	<artifactId>Sonaged</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Sonaged</name>
	<description>Demo project for Spring Boot</description>
	<properties>
		<java.version>21</java.version>
		<maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
		<liquibase.version>4.32.0</liquibase.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
		<spring-openapi.version>2.8.17</spring-openapi.version>
		<jsonwebtoken.version>0.12.6</jsonwebtoken.version>
		<liquibase-hibernate6.version>4.32.0</liquibase-hibernate6.version>
		<spring-modulith.version>1.4.1</spring-modulith.version>
		<minio.version>8.5.17</minio.version>
		<org-json.version>20260719</org-json.version>
		<!-- Versions retirées volontairement (gérées par le BOM Spring Boot 3.5.3) :
		     - hibernate-core : l'ancienne propriété `hibernate-core.version=7.0.0.Alpha2` était
		       ORPHELINE (Boot pilote Hibernate via `hibernate.version`) et ne s'appliquait pas ;
		       hibernate-core arrive transitivement par spring-boot-starter-data-jpa.
		     - postgresql, slf4j, swagger-annotations : versions alignées par le BOM / springdoc.
		     - maven-failsafe-plugin : propriété orpheline (plugin jamais déclaré). -->
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<!-- Spring Modulith : structure modulaire + tests de frontières (cf. docs/architecture-cible.md) -->
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-docs</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- P1-1 : springfox 3.0.0 retiré (abandonné, incompatible Spring Boot 3 ;
		     la doc OpenAPI est fournie par springdoc-openapi ci-dessous). Aucun usage
		     `springfox.documentation.*` dans src/main/java. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- P0-A : OAuth2 Resource Server (Keycloak, ADR-0011). Inerte tant qu'aucun
		     `spring.security.oauth2.resourceserver.jwt.issuer-uri` n'est configuré (profil `keycloak`).
		     Étapes d'activation : voir docs/keycloak-migration.md -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!-- Actuator : ajouté pour le déploiement conteneurisé (ADR-0019).
		     `application.yml` configurait déjà `management.endpoints.web.exposure.include`
		     depuis l'origine, mais la dépendance n'était pas au classpath : ce bloc était donc
		     inerte et l'application n'exposait AUCUN point de santé. Sans lui, un orchestrateur
		     ne peut pas distinguer « le port écoute » de « l'application est prête à servir » —
		     or Liquibase joue 126 changesets au démarrage, pendant lesquels le port écoute déjà.
		     Seul `/actuator/health` est ouvert (voir SecurityConfiguration). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web-services</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
			<exclusions>
				<!-- `jsonassert` traine `android-json`, qui redefinit le paquet `org.json` avec une
				     API amputee (pas de `JSONObject.keySet()`). En scope test il MASQUE le vrai
				     `org.json:json` utilise par l'import GeoJSON : tout test touchant
				     `UploadFileServiceImpl` echouait en `NoSuchMethodError`, alors que le meme code
				     fonctionne a l'execution. C'est pourquoi l'import n'avait aucun test.
				     L'exclusion ne retire que le shadowing ; `jsonassert` reste disponible. -->
				<exclusion>
					<groupId>com.vaadin.external.google</groupId>
					<artifactId>android-json</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Base en mémoire, uniquement pour `ApplicationContextLoadsTest` : jusqu'ici AUCUN test
		     ne démarrait le contexte Spring (le seul qui l'aurait fait était @Disabled faute de
		     PostgreSQL). Une erreur de câblage — bean manquant, injection ambiguë, référence
		     circulaire, entité hors du périmètre de scan — n'était donc détectable qu'au premier
		     démarrage réel. C'est le risque nommé par l'ADR-0013 lui-même.
		     H2 en mode compatibilité PostgreSQL, avec Liquibase désactivé et le schéma dérivé des
		     entités : ce test valide le CÂBLAGE, pas la correspondance au schéma Liquibase, qui
		     reste du ressort de `ddl-auto: validate` au démarrage réel. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${spring-openapi.version}</version>
		</dependency>
		<!-- `io.swagger.core.v3:swagger-annotations` retiré : springdoc fournit déjà
		     `swagger-annotations-jakarta`, qui expose le même package `io.swagger.v3.oas.annotations`.
		     Déclarer les deux mettait des classes en double sur le classpath. -->

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>
		<!-- `mapstruct-processor` n'est plus une dépendance de compilation : il est déclaré
		     en `annotationProcessorPaths` (maven-compiler-plugin) avec lombok et
		     lombok-mapstruct-binding, afin de garantir l'ordre des processeurs
		     (Lombok génère getters/setters AVANT que MapStruct ne lise le modèle). -->

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt</artifactId>
			<version>${jsonwebtoken.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jsonwebtoken.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jsonwebtoken.version}</version>
		</dependency>

		<!-- P1-1 : com.auth0:java-jwt retiré (2e bibliothèque JWT non utilisée ;
		     le pipeline JWT maison s'appuie sur jjwt / io.jsonwebtoken). -->

		<!-- Bean Validation via le starter officiel (fournit hibernate-validator aligné par le BOM). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- `org.hibernate.orm:hibernate-core` retiré : fourni transitivement par
		     spring-boot-starter-data-jpa, à la version testée par Boot 3.5.3. -->

		<dependency>
			<groupId>org.liquibase.ext</groupId>
			<artifactId>liquibase-hibernate6</artifactId>
			<version>${liquibase-hibernate6.version}</version>
		</dependency>
		<dependency>
			<groupId>org.liquibase</groupId>
			<artifactId>liquibase-core</artifactId>
			<!-- Inherited version from Spring Boot can't be used because of regressions -->
			<version>${liquibase.version}</version>
		</dependency>

		<!-- PostgreSQL Driver (version pilotée par le BOM Spring Boot) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
			<version>${org-json.version}</version>
		</dependency>

		<!-- Stockage objet des images/fichiers (P1-3 / ADR-0005) : MinIO (compatible S3) -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>${minio.version}</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!-- Ordre des annotation processors : Lombok d'abord (génère getters/setters),
			     lombok-mapstruct-binding ensuite, puis MapStruct qui lit le modèle complété. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>${lombok-mapstruct-binding.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs>
						<arg>-Amapstruct.unmappedTargetPolicy=WARN</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<!-- `skipTests=true` retiré : les tests doivent s'exécuter (`./mvnw test`). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<!-- `com.mysema.maven:apt-maven-plugin` retiré : plugin QueryDSL abandonné,
			     déclaré sans exécution et aucun usage `querydsl`/`com.mysema` dans src/. -->
			<plugin>
				<groupId>org.liquibase</groupId>
				<artifactId>liquibase-maven-plugin</artifactId>
				<version>${liquibase.version}</version>
				<configuration>
					<propertyFile>src/main/resources/config/liquibase/liquibase.properties</propertyFile>

				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>status</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>org.liquibase</groupId>
						<artifactId>liquibase-core</artifactId>
						<version>${liquibase.version}</version>
					</dependency>
					<dependency>
						<groupId>org.liquibase.ext</groupId>
						<artifactId>liquibase-hibernate6</artifactId>
						<version>${liquibase-hibernate6.version}</version>
					</dependency>
					<dependency>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-starter-data-jpa</artifactId>
						<version>${project.parent.version}</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>
	<!-- Dépôts spring-milestones / spring-snapshots retirés : toutes les dépendances sont
	     désormais des versions GA disponibles sur Maven Central (ils n'existaient que pour
	     l'ancien hibernate-core 7.0.0.Alpha2). -->
</project>

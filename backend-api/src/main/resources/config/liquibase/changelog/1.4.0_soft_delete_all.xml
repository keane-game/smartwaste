<?xml version="1.0" encoding="utf-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Soft-delete pour TOUTES les entités (héritant d'AbstractAuditingEntity).
      Ajoute `deletionstatus` (défaut ACTIVE) + `deletionrequestedat` à chaque table.
      Changesets idempotents (préconditions MARK_RAN). Nommage minuscule aligné sur le baseline.
    -->

    <changeSet id="1.4.0-alert-soft-delete" author="sonaged">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="alert" columnName="deletionstatus"/></not></preConditions>
        <addColumn tableName="alert">
            <column name="deletionstatus" type="VARCHAR(30)" defaultValue="ACTIVE"><constraints nullable="false"/></column>
            <column name="deletionrequestedat" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </addColumn>
    </changeSet>


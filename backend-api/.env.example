# Exemple de variables d'environnement du backend SONAGED.
# Copier en `.env` (ignoré par Git) et renseigner les valeurs réelles. NE PAS committer `.env`.

# Base de données PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/sonaged
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Nom de base seul, pour le service `postgres` de docker-compose.yml (P2-2) — doit désigner la
# même base que DB_URL ci-dessus.
DB_NAME=sonaged

# Envoi d'e-mails (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me

# Secret de signature JWT — voir note P0-2 : l'externalisation complète (SecurityConstants.SECRET)
# est réalisée avec P0-A (Keycloak), qui supprime la signature JWT maison.
# JWT_SECRET=change-me

# Stockage objet des images/fichiers (P1-3 / ADR-0005) — MinIO (compatible S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sonaged-images
# URL publique des objets (vide -> {MINIO_ENDPOINT}/{MINIO_BUCKET}) ; renseigner si proxy/CDN
MINIO_PUBLIC_URL=

# Import GeoJSON (P1-5)
GEOJSON_DIR=file:../datas
GEOJSON_IMPORT_ON_STARTUP=false

# Amorçage du compte d'administration (ADR-0014 §2) — sans ces deux variables au premier
# démarrage, l'API tourne mais AUCUN compte n'existe : /auth/register ne crée que des comptes
# USER, et l'activation exige un code envoyé par courriel. Idempotent : si un compte porte déjà
# cette adresse, le runner ne fait rien (ne réécrit pas le mot de passe).
SONAGED_ADMIN_EMAIL=admin@smartcollect.sn
SONAGED_ADMIN_PASSWORD=SmartCollect-dev-2026

    <!--
      Rattachement de tous les comptes existants à Pikine.

      Sans cette ligne, activer un jour le filtre `organizationFilter` par défaut fermé rendrait
      TOUT invisible à TOUT utilisateur existant (aucun rattachement n'a jamais été semé — 2.2.0-3
      le documentait déjà comme délibéré, tant que rien ne consommait `CurrentTenantProvider`).
      Ce n'est plus vrai à partir d'ici : le référentiel devient réellement cloisonné, donc chaque
      compte a besoin d'une collectivité pour continuer à voir quoi que ce soit. Un utilisateur
      déjà rattaché (cas futur, table non vide) n'est pas touché.
    -->
    <changeSet author="claude" id="2.27.0-13-backfill-memberships">
        <!--
          Pas de précondition de garde ici : la clause `WHERE NOT EXISTS` ci-dessous rend cette
          instruction naturellement idempotente (ré-exécutée, elle n'insère plus rien une fois tous
          les comptes rattachés) — contrairement à un `sqlCheck expectedResult="0"`, qui aurait
          l'effet inverse de celui recherché : il faudrait qu'il n'y ait PLUS aucun compte à
          rattacher pour que le changeset s'exécute, ce qui est exactement le cas où il n'y a rien à
          faire.
        -->
        <comment>Rattache tout compte existant, sans exception, à Ville de Pikine.</comment>
        <!--
          `gen_random_uuid()` produit un UUID v4, pas le v7 maison (UuidV7Generator) utilisé
          partout ailleurs dans ce projet pour la localité d'insertion en B-tree. Exception
          assumée : ce backfill est borné (une ligne par compte existant), exécuté une seule fois,
          pas un chemin d'écriture à chaud — l'argument de localité ne s'applique pas ici. Ne pas
          reproduire ce choix pour un chemin d'insertion applicatif.
        -->
        <sql>
            INSERT INTO organizationmembership (membershipid, userid, organizationid, archived,
                                                 createdby, lastmodifiedby, createddate, lastmodifieddate,
                                                 deletionstatus)
            SELECT gen_random_uuid(), u.userid, '${pikineOrgId}', false,
                   'system', 'system', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 'ACTIVE'
            FROM users u
            WHERE NOT EXISTS (SELECT 1 FROM organizationmembership m WHERE m.userid = u.userid);
        </sql>
    </changeSet>


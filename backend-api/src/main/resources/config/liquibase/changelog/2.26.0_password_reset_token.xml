<?xml version="1.0" encoding="utf-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Reinitialisation de mot de passe (ADR-0021, pont avant Keycloak). Non destructeur : une seule
      table ajoutee.

      `tokenhash` porte l'empreinte SHA-256 du jeton, jamais le jeton — meme raisonnement que
      `usersession.refreshtokenhash` (2.3.0) : une base exfiltree ne doit pas permettre de rejouer
      une reinitialisation.
    -->
    <changeSet author="claude" id="2.26.0-1-passwordresettoken">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="passwordresettoken"/></not>
        </preConditions>
        <comment>Reinitialisation de mot de passe : table dediee, separee des codes d'activation.</comment>
        <createTable tableName="passwordresettoken">
            <column name="tokenid" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_passwordresettoken"/>
            </column>
            <column name="userid" type="uuid"><constraints nullable="false"/></column>
            <column name="tokenhash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_passwordresettoken_hash"/>
            </column>
            <column name="expiresat" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="usedat" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex indexName="idx_passwordresettoken_userid" tableName="passwordresettoken">
            <column name="userid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
